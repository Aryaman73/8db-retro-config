{
  "name": "8bitdo-kbd",
  "version": "0.0.1",
  "description": "Cross-platform configurator for 8BitDo Retro Mechanical Keyboards (incl. N Edition) over USB HID.",
  "type": "module",
  "bin": {
    "8bdkbd": "src/cli.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p web",
    "status": "node src/cli.ts status",
    "list-keys": "node src/cli.ts list-keys",
    "probe": "node scripts/probe.cjs",
    "gen-keys": "node scripts/gen-keys.cjs",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "engines": {
    "node": ">=23"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "node-hid": "^3.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/w3c-web-hid": "^1.0.7",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
